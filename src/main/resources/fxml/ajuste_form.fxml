<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pos.controller.AjusteFormController"
      spacing="8" prefWidth="440">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <fx:define>
        <ToggleGroup fx:id="grupoTipo"/>
    </fx:define>

    <Label text="Producto"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label fx:id="lblProducto" text="(ninguno)" style="-fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity"
               wrapText="true"/>
        <Button text="Elegir..." onAction="#elegirProducto"/>
    </HBox>
    <Label fx:id="lblStockActual" styleClass="subtitulo"/>

    <Label text="Tipo de ajuste"/>
    <RadioButton fx:id="rbCantidad" text="Sumar o restar una cantidad (use - para restar, ej: -3)"
                 toggleGroup="$grupoTipo" selected="true" onAction="#tipoCambiado" wrapText="true"/>
    <RadioButton fx:id="rbConteo" text="Conteo físico: ingresar el stock real contado"
                 toggleGroup="$grupoTipo" onAction="#tipoCambiado" wrapText="true"/>

    <Label fx:id="lblCantidad" text="Cantidad"/>
    <TextField fx:id="txtCantidad"/>

    <Label text="Motivo"/>
    <ComboBox fx:id="cmbMotivo" maxWidth="Infinity"/>
    <Label text="Detalle"/>
    <TextField fx:id="txtDetalle" promptText="Obligatorio si el motivo es Otro"/>

    <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true" managed="false" visible="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <padding><Insets top="8"/></padding>
        <Button text="Cancelar" cancelButton="true" onAction="#cancelar"/>
        <Button fx:id="btnGuardar" text="Registrar ajuste" defaultButton="true" styleClass="boton-primario"
                onAction="#guardar"/>
    </HBox>
</VBox>
