<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pos.controller.CategoriasController" spacing="12">

    <Label text="Categorías" styleClass="titulo-modulo"/>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <TableView fx:id="tabla" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
                <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="280"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="90"/>
            </columns>
            <placeholder><Label text="No hay categorías"/></placeholder>
        </TableView>

        <VBox styleClass="tarjeta" spacing="8" prefWidth="300" minWidth="300">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Label fx:id="lblFormulario" text="Nueva categoría" styleClass="titulo-tarjeta"/>
            <Label text="Nombre"/>
            <TextField fx:id="txtNombre"/>
            <Label text="Descripción"/>
            <TextArea fx:id="txtDescripcion" prefRowCount="3" wrapText="true"/>
            <CheckBox fx:id="chkActiva" text="Activa" selected="true"/>
            <Label fx:id="lblMensaje" wrapText="true" managed="false" visible="false"/>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <padding><Insets top="8"/></padding>
                <Button text="Nueva" onAction="#nueva"/>
                <Button text="Guardar" styleClass="boton-primario" onAction="#guardar"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
