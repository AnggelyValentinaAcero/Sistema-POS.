<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pos.controller.BuscarClienteController"
      spacing="10" prefWidth="620" prefHeight="420">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <HBox spacing="8">
        <TextField fx:id="txtBuscar" HBox.hgrow="ALWAYS" promptText="Nombre o documento (Enter para buscar)"
                   onAction="#buscar"/>
        <Button text="Buscar" onAction="#buscar"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS" onMouseClicked="#clicTabla">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="260"/>
            <TableColumn fx:id="colDocumento" text="Documento" prefWidth="140"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="130"/>
        </columns>
        <placeholder><Label text="No se encontraron clientes"/></placeholder>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Registrar cliente nuevo" onAction="#nuevoCliente"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancelar" cancelButton="true" onAction="#cancelar"/>
        <Button fx:id="btnSeleccionar" text="Seleccionar" styleClass="boton-primario" onAction="#seleccionar"/>
    </HBox>
</VBox>
