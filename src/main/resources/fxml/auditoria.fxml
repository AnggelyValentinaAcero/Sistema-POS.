<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pos.controller.AuditoriaController" spacing="12">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Auditoría" styleClass="titulo-modulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblResultado" styleClass="subtitulo"/>
    </HBox>
    <Label text="Registro de las acciones sensibles del sistema. Solo se puede consultar: nadie puede modificarlo desde la aplicación."
           styleClass="subtitulo" wrapText="true"/>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Desde"/>
        <DatePicker fx:id="dpDesde" prefWidth="130"/>
        <Label text="Hasta"/>
        <DatePicker fx:id="dpHasta" prefWidth="130"/>
        <Label text="Usuario"/>
        <ComboBox fx:id="cmbUsuario" prefWidth="130"/>
        <Label text="Acción"/>
        <ComboBox fx:id="cmbAccion" prefWidth="200"/>
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="8">
        <TextField fx:id="txtTexto" promptText="Buscar en el detalle (ej: nombre de producto, motivo)" prefWidth="360"
                   onAction="#buscar"/>
        <Button text="Buscar" styleClass="boton-primario" onAction="#buscar"/>
        <Button text="Limpiar filtros" onAction="#limpiar"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="140" maxWidth="160"/>
            <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="100" maxWidth="140"/>
            <TableColumn fx:id="colTerminal" text="Terminal" prefWidth="110" maxWidth="150"/>
            <TableColumn fx:id="colAccion" text="Acción" prefWidth="170" maxWidth="220"/>
            <TableColumn fx:id="colReferencia" text="Referencia" prefWidth="110" maxWidth="160"/>
            <TableColumn fx:id="colDetalle" text="Detalle" prefWidth="380"/>
        </columns>
        <placeholder><Label text="No hay registros con esos filtros"/></placeholder>
    </TableView>
</VBox>
