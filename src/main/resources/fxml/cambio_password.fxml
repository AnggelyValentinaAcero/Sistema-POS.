<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pos.controller.CambioPasswordController"
      spacing="10" prefWidth="380">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <Label fx:id="lblAviso" wrapText="true" styleClass="subtitulo"/>

    <Label text="Contraseña actual"/>
    <HBox spacing="6" alignment="CENTER_LEFT">
        <StackPane HBox.hgrow="ALWAYS">
            <PasswordField fx:id="txtActual" maxWidth="Infinity"/>
            <TextField fx:id="txtActualVisible" maxWidth="Infinity" visible="false" managed="false"/>
        </StackPane>
        <Button fx:id="btnVerActual" text="👁" focusTraversable="false" styleClass="boton-ojo"/>
    </HBox>

    <Label text="Nueva contraseña"/>
    <HBox spacing="6" alignment="CENTER_LEFT">
        <StackPane HBox.hgrow="ALWAYS">
            <PasswordField fx:id="txtNueva" maxWidth="Infinity"/>
            <TextField fx:id="txtNuevaVisible" maxWidth="Infinity" visible="false" managed="false"/>
        </StackPane>
        <Button fx:id="btnVerNueva" text="👁" focusTraversable="false" styleClass="boton-ojo"/>
    </HBox>

    <Label text="Confirmar nueva contraseña"/>
    <HBox spacing="6" alignment="CENTER_LEFT">
        <StackPane HBox.hgrow="ALWAYS">
            <PasswordField fx:id="txtConfirmar" maxWidth="Infinity"/>
            <TextField fx:id="txtConfirmarVisible" maxWidth="Infinity" visible="false" managed="false"/>
        </StackPane>
        <Button fx:id="btnVerConfirmar" text="👁" focusTraversable="false" styleClass="boton-ojo"/>
    </HBox>

    <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true" managed="false" visible="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <padding><Insets top="8"/></padding>
        <Button text="Cancelar" cancelButton="true" onAction="#cancelar"/>
        <Button fx:id="btnGuardar" text="Cambiar contraseña" defaultButton="true"
                styleClass="boton-primario" onAction="#guardar"/>
    </HBox>
</VBox>
