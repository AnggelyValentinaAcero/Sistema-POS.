<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pos.controller.LoginController"
            prefWidth="1024" prefHeight="700">
    <center>
        <StackPane>
            <VBox styleClass="tarjeta" spacing="14" maxWidth="380" maxHeight="-Infinity">
                <padding><Insets top="32" right="36" bottom="28" left="36"/></padding>

                <Label text="Sistema POS" styleClass="titulo-tarjeta"/>
                <Label text="Inicie sesión para continuar" styleClass="subtitulo"/>

                <Label text="Usuario"/>
                <TextField fx:id="txtUsuario"/>
                <Label text="Contraseña"/>
                <PasswordField fx:id="txtPassword"/>

                <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true" managed="false" visible="false"/>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <ProgressIndicator fx:id="indicador" prefWidth="24" prefHeight="24" visible="false"/>
                    <Button fx:id="btnIngresar" text="Ingresar" defaultButton="true" maxWidth="Infinity"
                            HBox.hgrow="ALWAYS" styleClass="boton-primario" onAction="#ingresar"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>
    <bottom>
        <HBox styleClass="barra-estado" alignment="CENTER_LEFT" spacing="8">
            <padding><Insets top="4" right="12" bottom="4" left="12"/></padding>
            <Label fx:id="lblConexion"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Hyperlink text="Configurar conexión" onAction="#configurarConexion"/>
        </HBox>
    </bottom>
</BorderPane>
