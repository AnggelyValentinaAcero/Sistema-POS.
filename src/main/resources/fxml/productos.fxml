<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pos.controller.ProductosController" spacing="12">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Productos" styleClass="titulo-modulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox fx:id="panelBotones" spacing="10">
            <Button text="Nuevo" styleClass="boton-primario" onAction="#nuevo"/>
            <Button text="Editar" onAction="#editar"/>
            <Button text="Activar / Desactivar" onAction="#cambiarEstado"/>
        </HBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="txtBuscar" promptText="Buscar por nombre o código de barras" prefWidth="320"
                   onAction="#buscar"/>
        <Button text="Buscar" onAction="#buscar"/>
        <CheckBox fx:id="chkInactivos" text="Mostrar inactivos" onAction="#buscar"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Filas en rojo: stock en el mínimo o por debajo" styleClass="subtitulo"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS" onMouseClicked="#clicTabla">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="130"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="260"/>
            <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="130"/>
            <TableColumn fx:id="colPrecio" text="Precio venta" prefWidth="100"/>
            <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
            <TableColumn fx:id="colStockMinimo" text="Stock mín." prefWidth="80"/>
            <TableColumn fx:id="colUnidad" text="Unidad" prefWidth="70"/>
            <TableColumn fx:id="colImpuesto" text="Impuesto" prefWidth="90"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="80"/>
        </columns>
        <placeholder><Label text="No se encontraron productos"/></placeholder>
    </TableView>
</VBox>
