<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pos.controller.ConfiguracionController" fitToWidth="true" styleClass="sin-borde">
    <VBox spacing="16">
        <Label text="Configuración" styleClass="titulo-modulo"/>

        <FlowPane hgap="16" vgap="16">
            <!-- Mi cuenta y sesión -->
            <VBox styleClass="tarjeta" spacing="12" prefWidth="420">
                <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                <Label text="Mi cuenta y sesión" styleClass="titulo-tarjeta"/>
                <Label text="Gestione su contraseña y el acceso al sistema." styleClass="subtitulo"/>
                <GridPane hgap="10" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Usuario:" GridPane.rowIndex="0"/>
                    <Label fx:id="lblUsuarioActual" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Rol:" GridPane.rowIndex="1"/>
                    <Label fx:id="lblRolActual" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Terminal:" GridPane.rowIndex="2"/>
                    <Label fx:id="lblTerminalActual" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>
                <Region VBox.vgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Cambiar contraseña" onAction="#cambiarPassword"/>
                    <Button text="Cerrar sesión" styleClass="boton-peligro" onAction="#cerrarSesion"/>
                </HBox>
            </VBox>

            <!-- Datos del negocio: se guardan en la base de datos (compartidos por todas las cajas) -->
            <VBox fx:id="panelNegocio" styleClass="tarjeta" spacing="8" prefWidth="420">
                <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                <Label text="Datos del negocio" styleClass="titulo-tarjeta"/>
                <Label text="Aparecen en el encabezado del recibo." styleClass="subtitulo"/>
                <GridPane hgap="10" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Nombre" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Documento fiscal" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtDocumento" promptText="RUC / NIT / RFC" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Dirección" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtDireccion" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Teléfono" GridPane.rowIndex="3"/>
                    <TextField fx:id="txtTelefono" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Label text="Símbolo moneda" GridPane.rowIndex="4"/>
                    <TextField fx:id="txtSimbolo" prefColumnCount="4" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    <Label text="Mensaje final" GridPane.rowIndex="5"/>
                    <TextField fx:id="txtMensaje" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>
                <HBox alignment="CENTER_RIGHT">
                    <Button fx:id="btnGuardarNegocio" text="Guardar datos del negocio" styleClass="boton-primario" onAction="#guardarNegocio"/>
                </HBox>
            </VBox>

            <!-- Impresora: se guarda en pos.properties (propia de esta caja) -->
            <VBox styleClass="tarjeta" spacing="8" prefWidth="420">
                <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                <Label text="Impresora de esta terminal" styleClass="titulo-tarjeta"/>
                <Label fx:id="lblTerminal" styleClass="subtitulo"/>
                <GridPane hgap="10" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Tipo" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="cmbTipo" maxWidth="Infinity" onAction="#tipoCambiado" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Impresora" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="cmbImpresora" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Ancho del papel" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="cmbAncho" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>
                <CheckBox fx:id="chkAutomatico" text="Imprimir el recibo automáticamente al terminar cada venta"
                          wrapText="true"/>
                <CheckBox fx:id="chkCajon" text="Abrir el cajón de dinero al imprimir (solo impresora térmica)"
                          wrapText="true"/>
                <Label text="Para hacer pruebas sin impresora de recibos elija &quot;Impresora del sistema&quot; y &quot;Microsoft Print to PDF&quot;."
                       wrapText="true" styleClass="subtitulo"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Imprimir prueba" onAction="#imprimirPrueba"/>
                    <Button text="Guardar impresora" styleClass="boton-primario" onAction="#guardarImpresora"/>
                </HBox>
            </VBox>
        </FlowPane>
    </VBox>
</ScrollPane>
