<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pos.controller.ProveedoresController" spacing="12">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Proveedores" styleClass="titulo-modulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nuevo" styleClass="boton-primario" onAction="#nuevo"/>
        <Button text="Editar" onAction="#editar"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="txtBuscar" promptText="Buscar por nombre o documento" prefWidth="320" onAction="#buscar"/>
        <Button text="Buscar" onAction="#buscar"/>
        <CheckBox fx:id="chkInactivos" text="Mostrar inactivos" onAction="#buscar"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS" onMouseClicked="#clicTabla">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="240"/>
            <TableColumn fx:id="colDocumento" text="Documento" prefWidth="130"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="80"/>
        </columns>
        <placeholder><Label text="No se encontraron proveedores"/></placeholder>
    </TableView>
</VBox>
