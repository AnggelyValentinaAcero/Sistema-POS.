<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pos.controller.UsuarioFormController"
      spacing="8" prefWidth="400">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <Label text="Usuario"/>
    <TextField fx:id="txtUsuario" promptText="ej: jperez"/>

    <Label text="Nombre completo"/>
    <TextField fx:id="txtNombre"/>

    <Label text="Rol"/>
    <ComboBox fx:id="cmbRol" maxWidth="Infinity"/>

    <!-- Solo se muestra al crear un usuario nuevo -->
    <VBox fx:id="panelPassword" spacing="8">
        <Label text="Contraseña inicial"/>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <StackPane HBox.hgrow="ALWAYS">
                <PasswordField fx:id="txtPassword" maxWidth="Infinity"/>
                <TextField fx:id="txtPasswordVisible" maxWidth="Infinity" visible="false" managed="false"/>
            </StackPane>
            <Button fx:id="btnVerPassword" text="👁" focusTraversable="false" styleClass="boton-ojo"/>
        </HBox>

        <Label text="Confirmar contraseña"/>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <StackPane HBox.hgrow="ALWAYS">
                <PasswordField fx:id="txtConfirmar" maxWidth="Infinity"/>
                <TextField fx:id="txtConfirmarVisible" maxWidth="Infinity" visible="false" managed="false"/>
            </StackPane>
            <Button fx:id="btnVerConfirmar" text="👁" focusTraversable="false" styleClass="boton-ojo"/>
        </HBox>

        <Label text="El usuario deberá cambiarla en su primer ingreso." styleClass="subtitulo" wrapText="true"/>
    </VBox>

    <CheckBox fx:id="chkActivo" text="Usuario activo"/>

    <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true" managed="false" visible="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <padding><Insets top="8"/></padding>
        <Button text="Cancelar" cancelButton="true" onAction="#cancelar"/>
        <Button fx:id="btnGuardar" text="Guardar" defaultButton="true" styleClass="boton-primario" onAction="#guardar"/>
    </HBox>
</VBox>
